[Unit]
Description=iBOX TV web application (Gunicorn)
After=network.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_ROOT__/current
EnvironmentFile=__APP_ROOT__/shared/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_ROOT__/shared/venv/bin/gunicorn "tv_app.app:app" --workers 2 --bind 127.0.0.1:8000 --timeout 30 --graceful-timeout 10 --keep-alive 5 --max-requests 500 --max-requests-jitter 50
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
