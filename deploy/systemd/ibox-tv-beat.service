[Unit]
Description=iBOX TV Celery scheduler
After=network.target redis-server.service ibox-tv-worker.service
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_ROOT__/current
EnvironmentFile=__APP_ROOT__/shared/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_ROOT__/shared/venv/bin/celery -A tv_app.tasks beat --loglevel=INFO --schedule=__APP_ROOT__/shared/celerybeat-schedule
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
