# Core application configuration. Copy to .env locally or to the shared
# environment file on a VPS. Never commit real values.
SECRET_KEY=replace-with-a-long-random-value
SITE_BASE_URL=https://ibox-tv.com
LEGACY_SITE_HOSTS=anime.ibox-tv.com,movies.ibox-tv.com,www.ibox-tv.com
DATABASE_URL=postgresql://user:password@localhost/tv_shows_db
REDIS_URL=redis://localhost:6379/0

# Optional responsive manual AdSense units. Create display units in AdSense
# and paste only their numeric data-ad-slot values here. Auto Ads still runs
# independently; leave these blank until you have the approved slot IDs.
ADSENSE_CLIENT=ca-pub-3351229899410110
ADSENSE_HOME_SLOT=
ADSENSE_DETAIL_SLOT=

# Protects administrative operations; use a different random value from SECRET_KEY.
ADMIN_TOKEN=replace-with-a-long-random-value
NUKE_COOKIE_TTL_DAYS=30

# Telegram ingestion (TV and anime are required for their respective feeds).
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHANNEL_ID=-1000000000000
TELEGRAM_ANIME_CHANNEL_ID=-1000000000001
BOT_USERNAME=iBoxTVBot

# TMDB metadata enrichment. TMDB_BACKFILL_TOKENS is optional and comma-separated.
TMDB_BEARER_TOKEN=replace-with-tmdb-bearer-token
TMDB_BACKFILL_TOKENS=replace-with-comma-separated-tokens

# Optional MongoDB movie-backfill source.
MONGO_URI_1=mongodb+srv://user:password@example.mongodb.net/
MONGO_URI_2=
MONGO_DB_NAME=replace-with-database-name
MONGO_COL_NAME=replace-with-collection-name

# Optional cache tuning (the defaults are shown here for clarity).
GENRE_HUB_CACHE_TTL=21600
TRENDING_CACHE_TTL=900
PUBLIC_PAGE_CACHE_TTL=3600
POPULAR_LEADERBOARD_TTL=43200
POPULAR_LEADERBOARD_MAX_TITLES=300
